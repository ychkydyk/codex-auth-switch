{
  "name": "codex-auth-switch",
  "displayName": "Codex: API / Subscription",
  "description": "Switch Codex between API billing and ChatGPT subscription access.",
  "version": "1.1.0",
  "publisher": "wedoai-local",
  "license": "MIT",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other"],
  "main": "./extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "extensionKind": ["ui"],
  "capabilities": {"untrustedWorkspaces":{"supported":false}},
  "contributes": {
    "commands": [
      {"command":"wedoCodexAuth.switch","title":"Codex: API / Подписка","icon":"$(account)"},
      {"command":"wedoCodexAuth.api","title":"Codex: переключить на API"},
      {"command":"wedoCodexAuth.chatgpt","title":"Codex: переключить на подписку ChatGPT"},
      {"command":"wedoCodexAuth.refresh","title":"Codex: проверить способ входа"}
    ],
    "menus": {
      "view/title":[{"command":"wedoCodexAuth.switch","when":"view == chatgpt.sidebarView || view == chatgpt.sidebarSecondaryView","group":"navigation@1"}],
      "editor/title":[{"command":"wedoCodexAuth.switch","when":"activeCustomEditorId == chatgpt.conversationEditor","group":"navigation@1"}]
    },
    "keybindings":[{"command":"wedoCodexAuth.switch","key":"ctrl+alt+shift+a"}]
  }
}
